# ---------------------------------------------------------------------------
# IdeaVault configuration. Copy to `.env` (gitignored) and adjust.
# Every value has a safe local default; nothing here is required to start.
# ---------------------------------------------------------------------------

# --- Local infrastructure (docker compose) ---------------------------------
POSTGRES_USER=ideavault
POSTGRES_PASSWORD=ideavault
POSTGRES_DB=ideavault
POSTGRES_PORT=5432          # change if 5432 is taken locally (e.g. 5442)
REDIS_PORT=6379

# --- API --------------------------------------------------------------------
APP_ENV=development         # development | production
PORT=8080
DATABASE_URL=postgres://ideavault:ideavault@localhost:5432/ideavault?sslmode=disable
REDIS_URL=redis://localhost:6379/0   # optional; empty = in-memory cache/rate limits
WEB_ORIGINS=http://localhost:3000    # comma-separated allowed browser origins
PUBLIC_API_URL=                      # optional, shown in OpenAPI servers
AUTO_MIGRATE=true
LOG_LEVEL=info
LOG_FORMAT=text                      # json in production

# 32 random bytes, base64. REQUIRED in production (encrypts stored credentials).
#   openssl rand -base64 32
MASTER_KEY=

# Sessions / cookies
SESSION_TTL=720h
COOKIE_SECURE=false                  # true in production (HTTPS)
COOKIE_DOMAIN=
# Create the owner automatically on first boot (optional; otherwise use /setup in the UI)
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=

# --- AI providers (all optional; configure any subset) ---------------------
# Keys can also be added in the UI (Models → Providers); they are stored AES-256-GCM encrypted.
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=                     # e.g. http://localhost:11434/v1 for local models

# Embeddings: auto | openai | gemini | ollama | local (local = free offline hashing embedder)
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=

# Deterministic offline planner only (tests / demos without AI). Never in production.
MOCK_AI=false

# --- Limits -----------------------------------------------------------------
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_AGENT_PER_MIN=30
RATE_LIMIT_IMPORT_PER_MIN=10
RATE_LIMIT_API_PER_MIN=600
MAX_UPLOAD_MB=200
WORKER_CONCURRENCY=2

# --- Web (apps/web) ----------------------------------------------------------
# Where the Next.js server proxies /api/* (server-side only; never exposed to the browser).
API_ORIGIN=http://localhost:8080

# --- Tests --------------------------------------------------------------------
TEST_DATABASE_URL=postgres://ideavault:ideavault@localhost:5432/ideavault_test?sslmode=disable
